# Cloudflare Pages cache policy. The default (max-age=0) forces a revalidation on
# every navigation, which is what made bot traffic so expensive on Render.

# Vite fingerprints these, so the name changes whenever the content does.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Not fingerprinted -- rename the file if you ever change one, or purge the cache.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/icons/*
  Cache-Control: public, max-age=2592000

/images/*
  Cache-Control: public, max-age=2592000

# The shell and the service worker must stay fresh or clients pin to an old build.
/index.html
  Cache-Control: public, max-age=0, must-revalidate

/sw.js
  Cache-Control: public, max-age=0, must-revalidate

/manifest.webmanifest
  Cache-Control: public, max-age=0, must-revalidate
